const window = @import("github.com/moglang/window")
if (window.PACKAGE_ID != "github.com/moglang/window") error("package identifier")
if (window.KEY_ESCAPE == 0i64) error("escape key constant")
if (window.KEY_SPACE == 0i64) error("space key constant")

var win window.Window = window.create("Mog window package test", 64, 64)
if (window.windowId(win) <= 0) error("window identifier")
window.show(win)
window.hide(win)
window.clear(win)
window.clearRgb(win, 12, 34, 56)
window.fillRect(win, -4, -4, 16, 16, 255, 0, 0)
window.drawText(win, 2, 2, "Mog\n1", 1, 255, 255, 255)
window.present(win)
if (window.isKeyDown(win, window.KEY_ESCAPE)) error("escape unexpectedly pressed")
var event window.Event? = window.pollEvent(win)
if (event != null) {
    if (window.eventWindowId(event) < 0) error("event window identifier")
}
window.delay(1)
window.close(win)
